# Proveedor primario compatible con OpenAI Chat Completions.
# Cerebras cloud: https://api.cerebras.ai/v1 + gpt-oss-120b
# Ollama local: http://127.0.0.1:11434/v1 + gpt-oss:20b (clave ficticia: ollama)
PRIMARY_AI_BASE_URL=
PRIMARY_AI_API_KEY=
PRIMARY_AI_MODEL=
PRIMARY_AI_TIMEOUT_MS=12000

# Respaldo de pago. La URL oficial se fija en el servidor y no usa OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=25000

# Fuerza el modo determinista y evita toda salida a proveedores (útil en pruebas).
AI_OFFLINE=

# En producción, evita mostrar una respuesta demo si todos los proveedores fallan.
AI_REQUIRE_PROVIDER=1

NEXT_PUBLIC_SITE_URL=http://localhost:3000
